# WireGuard VPN Configuration
# Copy this file to .env.prod and fill in your values

# Server public IPv4 address (required)
WG_HOST=YOUR_SERVER_IP

# Web UI password hash (bcrypt) (required)
# Generate with: docker run --rm ghcr.io/wg-easy/wg-easy wgpw 'YOUR_PASSWORD'
# IMPORTANT: Double all $ signs for docker-compose (e.g., $2a → $$2a)
PASSWORD_HASH=$$2a$$12$$REPLACE_WITH_YOUR_HASH

# WireGuard UDP port
WG_PORT=51820

# DNS servers for clients (Cloudflare + Google)
WG_DEFAULT_DNS=1.1.1.1,8.8.8.8

# Route all traffic through VPN (full tunnel)
# Use 10.8.0.0/24 for split tunnel (VPN network only)
WG_ALLOWED_IPS=0.0.0.0/0,::/0

# Keep connection alive (seconds) - important for NAT/mobile
WG_PERSISTENT_KEEPALIVE=25

# Client IP range
WG_DEFAULT_ADDRESS=10.8.0.x

# MTU (1420 is safe for most ISPs, lower if you have connection issues)
WG_MTU=1420
